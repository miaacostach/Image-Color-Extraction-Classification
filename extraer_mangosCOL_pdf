def limpiar(texto):
    return re.sub(r"\s+", " ", texto.replace("\xad", "")).strip()


def slug(texto):
    texto = unicodedata.normalize("NFKD", texto).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-zA-Z0-9]+", "_", texto).strip("_").lower()


def sha256(datos):
    return hashlib.sha256(datos).hexdigest()


def lineas(pagina):
    """Texto horizontal con coordenadas; mantiene etiquetas y valores separados."""
    resultado = []
    for bloque in pagina.get_text("dict", flags=fitz.TEXTFLAGS_DICT & ~fitz.TEXT_PRESERVE_IMAGES)["blocks"]:
        for linea in bloque.get("lines", []):
            if abs(linea["dir"][1]) > 0.1:
                continue  # titulos verticales de las secciones
            texto = limpiar("".join(s["text"] for s in linea["spans"]))
            if texto:
                resultado.append({"texto": texto, "bbox": list(linea["bbox"]),
                                  "fuentes": sorted({s["font"] for s in linea["spans"]})})
    return resultado


def identificador(pagina):
    ids = set(re.findall(r"\b721\d{5}\b", pagina.get_text()))
    if len(ids) != 1:
        raise ValueError(f"Se esperaba un registro GRIN unico: {ids}")
    return ids.pop()


def pagina_impresa(pagina):
    candidatos = [l["texto"] for l in lineas(pagina)
                  if l["bbox"][1] > 570 and re.fullmatch(r"\d{1,3}", l["texto"])]
    if len(candidatos) != 1:
        raise ValueError("No se pudo identificar de forma univoca el numero impreso.")
    return int(candidatos[0])


